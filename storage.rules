rules_version = '2';
// Replace TEACHER_UID_HERE with the teacher's user id (same as in firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {
    // Homework materials uploaded by the teacher (Word, PDF, PowerPoint, Excel, images, audio): every signed-in student can open them.
    match /materials/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'TEACHER_UID_HERE'
                   && request.resource.size < 20 * 1024 * 1024;
    }
    // Students' speaking videos (MP4/WebM, max 20 MB): only the student and the teacher can open them.
    match /uploads/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'TEACHER_UID_HERE');
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|webm)');
    }
  }
}
